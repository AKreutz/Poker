<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The Room database is restored from Google Drive on first sync; a stale
         backup would otherwise reappear on "clean" installs and mask real bugs. -->
    <exclude domain="database" path="poker.db" />
    <exclude domain="database" path="poker.db-wal" />
    <exclude domain="database" path="poker.db-shm" />
</full-backup-content>