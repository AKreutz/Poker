<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The Room database is restored from Google Drive on first sync; a stale
             backup would otherwise reappear on "clean" installs and mask real bugs. -->
        <exclude domain="database" path="poker.db" />
        <exclude domain="database" path="poker.db-wal" />
        <exclude domain="database" path="poker.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="poker.db" />
        <exclude domain="database" path="poker.db-wal" />
        <exclude domain="database" path="poker.db-shm" />
    </device-transfer>
</data-extraction-rules>